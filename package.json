{
  "name": "hpsales",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "repository": "<Add your repository here>",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap-cloud-sdk/http-client": "^4.1.1",
    "@sap/cds": "^9",
    "@sap/xssec": "^4",
    "express": "^4",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@cap-js/cds-types": "^0.13.0",
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": ">=8"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-hpsales": "cds watch --open hpsales/webapp/index.html?sap-ui-xx-viewCache=false"
  },
  "cds": {
    "requires": {
      "my_destination": {
        "kind": "destination",
        "credentials": {
          "URL": "https://my-destination.example.com",
          "ProxyType": "Internet",
          "Authentication": "OAuth2ClientCredentials",
          "ClientID": "my-client-id",
          "ClientSecret": "my-client-secret"
        }
      },
      "[production]": {
        "auth": "xsuaa"
      }
    }
  },
  "sapux": [
    "app/hpsales"
  ]
}
